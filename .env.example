# Copie para .env e preencha localmente. Nunca commitar o .env real.

# Bot do Telegram — reaproveite o token/bot que voce ja tem configurado
# em outro projeto, se aplicavel. Nao procure tokens em outros diretorios
# automaticamente: informe o caminho ou o valor aqui.
TELEGRAM_BOT_TOKEN=
# IDs de chat autorizados a usar o bot, separados por virgula
TELEGRAM_ALLOWED_CHAT_IDS=

# Timezone padrao usada em timestamps e agendamento
MONITOR_TZ=America/Recife
